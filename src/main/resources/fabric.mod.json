{
  "schemaVersion": 1,
  "id": "courierpost",
  "version": "${version}",
  "name": "Courier's Roost",
  "description": "All chat is delivered by courier birds that physically fly to their recipients.",
  "authors": [
    "menonng"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/couriers-roost",
    "sources": "https://github.com/menonng/couriersRoost",
    "issues": "https://github.com/menonng/couriersRoost/issues"
  },
  "icon": "assets/courierpost/icon.png",
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.courierpost.CourierPost"
    ]
  },
  "mixins": [
    "courierpost.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
